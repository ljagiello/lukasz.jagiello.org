# Copy to .env.local for local development. On Vercel, set these under
# Project Settings > Environment Variables (Production).

# GA4 measurement ID (Admin > Data streams > Web). Analytics is off when unset.
NEXT_PUBLIC_GA_ID=

# Optional: content of the google-site-verification meta tag from Search Console
# (URL-prefix property, "HTML tag" method).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
